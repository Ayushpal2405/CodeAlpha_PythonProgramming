prices = {
    "AAPL": 180,
    "TSLA": 250,
    "GOOG": 140,
    "MSFT": 320,
    "AMZN": 135
}

portfolio = {}
total_investment = 0

print("Stock Portfolio Tracker")
print("Available stocks:", ", ".join(prices.keys()))
print("Type 'done' when finished.\n")

while True:
    stock = input("Enter stock symbol: ").upper().strip()
    if stock == "DONE":
        break

    if stock not in prices:
        print("Stock not found. Try again.")
        continue

    qty_input = input("Enter quantity: ").strip()
    if not qty_input.isdigit() or int(qty_input) <= 0:
        print("Please enter a valid positive number.")
        continue

    qty = int(qty_input)
    portfolio[stock] = portfolio.get(stock, 0) + qty

print("\n--- Portfolio Summary ---")
for stock, qty in portfolio.items():
    value = prices[stock] * qty
    total_investment += value
    print(f"{stock}: {qty} shares x ${prices[stock]} = ${value}")

print(f"\nTotal Investment: ${total_investment}")

save = input("\nSave summary to a file? (y/n): ").lower().strip()
if save == "y":
    file_type = input("Choose format (txt/csv): ").lower().strip()

    if file_type == "csv":
        with open("portfolio.csv", "w") as f:
            f.write("Stock,Quantity,Price,Value\n")
            for stock, qty in portfolio.items():
                value = prices[stock] * qty
                f.write(f"{stock},{qty},{prices[stock]},{value}\n")
            f.write(f"Total,,,{total_investment}\n")
        print("Saved to portfolio.csv")
    else:
        with open("portfolio.txt", "w") as f:
            f.write("Portfolio Summary\n")
            for stock, qty in portfolio.items():
                value = prices[stock] * qty
                f.write(f"{stock}: {qty} shares x ${prices[stock]} = ${value}\n")
            f.write(f"\nTotal Investment: ${total_investment}\n")
        print("Saved to portfolio.txt")
